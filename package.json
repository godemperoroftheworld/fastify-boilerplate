{
  "name": "fastify-boilerplate",
  "version": "1.0.0",
  "author": "t2pellet",
  "license": "LGPL-3.0-only",
  "description": "Fastify boilerplate",
  "main": "main.js",
  "private": true,
  "scripts": {
    "prebuild": "prisma generate && eslint --fix 'src/schemas/zod/**/*.ts'",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/index.js",
    "dev": "nodemon | pino-pretty",
    "type-check": "tsc --build --force",
    "update:packages": "yarn npm-check-updates -u",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "lint:error": "eslint --quiet 'src/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts'",
    "prepare": "cd .. && husky backend/.husky",
    "commit": "cz"
  },
  "engines": {
    "node": "22"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "./node_modules/.bin/ts-node --files -r tsconfig-paths/register ./src"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@krsbx/prisma-fqp": "^0.2.8",
    "@prisma/client": "^6.19.3",
    "@prisma/sdk": "^4.0.0",
    "axios": "^1.14.0",
    "dotenv": "^17.4.0",
    "fastify": "^5.8.4",
    "fastify-type-provider-zod": "^6.1.0",
    "lodash": "^4.18.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76",
    "zod-prisma-types": "^3.2.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^9.39.4",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint-plugin-prettier": "^3.1.3",
    "@types/http-errors": "^2.0.5",
    "@types/lint-staged": "^14.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.5.2",
    "@types/nodemon": "^3.1.1",
    "@types/prettier": "^3.0.0",
    "@typescript-eslint/parser": "^8.26.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^3.8.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prisma": "^6.19.3",
    "tap": "^21.6.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.26.1"
  },
  "packageManager": "yarn@4.9.2",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
